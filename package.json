{
  "name": "nuxt-bezier",
  "version": "1.12.1",
  "description": "Nuxt reusable transition components",
  "author": {
    "name": "50rayn",
    "email": "soryngitlan@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/50rayn/nuxt-bezier.git"
  },
  "homepage": "https://50rayn.github.io/nuxt-bezier/",
  "bugs": {
    "url": "https://github.com/50rayn/nuxt-bezier/issues",
    "email": "soryngitlan@gmail.com"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types.d.ts",
      "import": "./dist/module.mjs",
      "require": "./dist/module.cjs"
    }
  },
  "main": "./dist/module.cjs",
  "types": "./dist/types.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "nuxt-module-build build",
    "dev": "nuxi dev playground",
    "dev:build": "nuxi build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playground",
    "release": "npm run lint && npm run test && npm run prepack && bumpp package.json playground/package.json --commit --push --tag",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest watch"
  },
  "dependencies": {
    "@noction/vue-bezier": "^2.0.3",
    "@nuxt/kit": "^4.3.0"
  },
  "devDependencies": {
    "@nuxt/devtools": "^3.1.1",
    "@nuxt/eslint-config": "^1.13.0",
    "@nuxt/fonts": "^0.11.0",
    "@nuxt/module-builder": "^1.0.2",
    "@nuxt/schema": "^4.3.0",
    "@nuxt/test-utils": "^3.23.0",
    "@types/node": "^25.0.10",
    "bumpp": "^10.4.0",
    "changelogen": "^0.6.2",
    "eslint": "^9.39.2",
    "normalize.css": "^8.0.1",
    "nuxt": "^4.3.0",
    "shiki": "^3.21.0",
    "typescript": "~5.9.3",
    "vitest": "^4.0.18"
  },
  "packageManager": "pnpm@10.28.0"
}
